# Enable every fail-closed production configuration guard in the documented
# bare-metal run path. Use NODE_ENV=development only for an intentional local
# evaluation with placeholder credentials.
NODE_ENV=production

# Port the websocket server listens on.
PORT=1234

# Interface the websocket server binds to. Loopback by default; set this
# (e.g. 0.0.0.0) only when clients connect from other machines. Docker sets
# it for the port mapping to work.
#HOST=127.0.0.1

# Comma-separated list of accepted authentication tokens. The client passes
# its token via HocuspocusProvider({ token }). Several values let you rotate
# without downtime: add the new token, move clients across, drop the old one.
# Replace the token list with a real lookup (JWT, session table) in
# src/create-server.mjs before production (the readme shows the swap). A
# static token reaches the browser, so one user can read it and connect to
# any document from a script, and withdrawing it disconnects everyone at once.
# Placeholder values such as "change-me" are refused unless NODE_ENV=development.
COLLAB_TOKENS=change-me
# Alternative for a mounted secret (never set both):
#COLLAB_TOKENS_FILE=/run/secrets/collab_tokens

# SQLite file the documents persist to; use :memory: for throwaway runs.
SQLITE_PATH=collab.sqlite

# Optional: comma-separated VIEWER tokens. Connections presenting one of
# these get the document read-only, enforced server-side (the server drops
# their writes even from a tampered client).
#COLLAB_READONLY_TOKENS=viewer-token
#COLLAB_READONLY_TOKENS_FILE=/run/secrets/collab_readonly_tokens

# Secure production default: the starter authorizeDocument callback permits a
# valid token to reach every document. Production refuses to start until you
# replace that callback for tenant-aware authorization. Set this to 1 only for
# a deliberate single-tenant/global-token deployment.
#COLLAB_ALLOW_TOKEN_WIDE_DOCUMENT_ACCESS=1

# Maximum websocket message size in bytes (default 8 MiB, hard ceiling 64 MiB).
#WS_MAX_PAYLOAD_BYTES=8388608

# Optional: REST API port (0 or unset disables it). Same tokens as above,
# passed as "Authorization: Bearer <token>"; read-only tokens get GET routes.
#REST_PORT=1235

# Optional: interface the REST API binds to. Loopback by default; set this
# (e.g. 0.0.0.0) only when the API should be reachable from other machines.
#REST_HOST=127.0.0.1

# Optional: webhook receiver for signed lifecycle events
# (document.changed, client.connected, client.disconnected). Leaving the
# secret unset is refused in production. An authenticating outer system may
# explicitly opt into unsigned delivery with WEBHOOK_ALLOW_UNSIGNED=1.
#WEBHOOK_URL=https://example.test/hooks/collab
#WEBHOOK_SECRET=change-me-too
#WEBHOOK_SECRET_FILE=/run/secrets/webhook_secret
#WEBHOOK_ALLOW_UNSIGNED=1
# HTTPS is mandatory in production. For a trusted private-network HTTP receiver
# only, explicitly set WEBHOOK_ALLOW_INSECURE_HTTP=1.
#WEBHOOK_ALLOW_INSECURE_HTTP=1
