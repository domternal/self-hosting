{
  "name": "domternal-collab-server",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Reference Hocuspocus server for Domternal Pro collaboration",
  "scripts": {
    "start": "node --env-file-if-exists=.env --input-type=module --eval \"process.env.NODE_ENV='production'; await import('./index.mjs')\"",
    "check:lock": "node scripts/check-lockfile.mjs .",
    "check:artifacts": "node scripts/check-artifacts.mjs .",
    "check:database": "node --env-file-if-exists=.env scripts/sqlite-maintenance.mjs check"
  },
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "dependencies": {
    "@hocuspocus/extension-sqlite": "4.6.0",
    "@hocuspocus/server": "4.6.0",
    "better-sqlite3": "12.11.1",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.32"
  }
}
