# Non-secret variables and host secret-file paths read by docker-compose.yml.
# Sensitive values live in the ignored ./secrets directory by default and are
# mounted read-only under /run/secrets inside the designated container. Follow
# README.md to create the directory and files with portable permissions. Use
# absolute paths here when a host secret manager stores them elsewhere.

# --- collab-server ---
COLLAB_TOKENS_SOURCE_FILE='./secrets/collab_tokens'
COLLAB_READONLY_TOKENS_SOURCE_FILE='./secrets/collab_readonly_tokens'
WEBHOOK_URL=''
WEBHOOK_SECRET_SOURCE_FILE='./secrets/webhook_secret'
# Production refuses the starter callback while this is empty. Set '1' only
# for a deliberate single-tenant deployment where every token may access every
# document; multi-tenant deployments replace authorizeDocument in index.mjs.
COLLAB_ALLOW_TOKEN_WIDE_DOCUMENT_ACCESS=''
WS_MAX_PAYLOAD_BYTES='8388608'
# Leave empty. Set '1' only when a trusted outer system authenticates webhooks.
WEBHOOK_ALLOW_UNSIGNED=''
# Leave empty. Set '1' only for a trusted private-network HTTP webhook.
WEBHOOK_ALLOW_INSECURE_HTTP=''
COLLAB_HOST_PORT='1234'
COLLAB_REST_HOST_PORT='1235'

# --- ai-proxy ---
UPSTREAM_URL='https://api.openai.com/v1/chat/completions'
PROVIDER='openai'
# Leave empty. Set '1' only for a trusted private-network HTTP model/gateway.
UPSTREAM_ALLOW_INSECURE_HTTP=''
PROVIDER_API_KEY_SOURCE_FILE='./secrets/provider_api_key'
AI_TOKENS_SOURCE_FILE='./secrets/ai_tokens'
ALLOWED_ORIGINS=''
REQUEST_TIMEOUT_MS='120000'
AI_HOST_PORT='1250'
