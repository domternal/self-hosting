# Variables docker-compose.yml reads. Compose turns the sensitive values into
# files mounted under /run/secrets; they are not copied into image layers or
# exposed in the container environment. The local .env file is still a secret:
#   cp .env.example .env
#   chmod 600 .env
# Generate each token independently with `openssl rand -hex 32`, then paste it
# between single quotes. Hex has no comma, whitespace or Compose metacharacters.
# Placeholder values such as "change-me" are refused in production.

# --- collab-server ---
COLLAB_TOKENS=''
COLLAB_READONLY_TOKENS=''
WEBHOOK_URL=''
WEBHOOK_SECRET=''
# Production refuses the starter callback while this is empty. Set '1' only
# for a deliberate single-tenant deployment where every token may access every
# document; multi-tenant deployments replace authorizeDocument in index.mjs.
COLLAB_ALLOW_TOKEN_WIDE_DOCUMENT_ACCESS=''
WS_MAX_PAYLOAD_BYTES='8388608'
# Leave empty. Set '1' only when a trusted outer system authenticates webhooks.
WEBHOOK_ALLOW_UNSIGNED=''
# Leave empty. Set '1' only for a trusted private-network HTTP webhook.
WEBHOOK_ALLOW_INSECURE_HTTP=''
COLLAB_HOST_PORT='1234'
COLLAB_REST_HOST_PORT='1235'

# --- ai-proxy ---
UPSTREAM_URL='https://api.openai.com/v1/chat/completions'
PROVIDER='openai'
# Leave empty. Set '1' only for a trusted private-network HTTP model/gateway.
UPSTREAM_ALLOW_INSECURE_HTTP=''
PROVIDER_API_KEY=''
AI_TOKENS=''
ALLOWED_ORIGINS=''
REQUEST_TIMEOUT_MS='120000'
AI_HOST_PORT='1250'
