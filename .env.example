# Variables docker-compose.yml reads; compose loads nothing from the
# per-service .env files, so the Docker path needs this one:
#   cp .env.example .env
# The per-service .env.example files document every variable in detail.
# Set real secrets here: the containers run with NODE_ENV=production, so
# placeholder values such as "change-me" are refused at startup.

# --- collab-server ---
COLLAB_TOKENS=
#COLLAB_READONLY_TOKENS=
#WEBHOOK_URL=
#WEBHOOK_SECRET=

# --- ai-proxy ---
UPSTREAM_URL=https://api.openai.com/v1/chat/completions
PROVIDER=openai
PROVIDER_API_KEY=
AI_TOKENS=
#ALLOWED_ORIGINS=
#REQUEST_TIMEOUT_MS=
