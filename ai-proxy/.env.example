# Port the proxy listens on.
PORT=1250

# Interface the proxy binds to. Loopback by default; set this (e.g. 0.0.0.0)
# only when the proxy should be reachable from other machines. Docker sets
# it for the port mapping to work.
#HOST=127.0.0.1

# Full provider or gateway endpoint the proxy forwards to. The editor's
# `protocol` option must match what lives here:
#   openai-chat         https://api.openai.com/v1/chat/completions
#   anthropic-messages  https://api.anthropic.com/v1/messages
#   local model         http://127.0.0.1:11434/v1/chat/completions (Ollama)
UPSTREAM_URL=https://api.openai.com/v1/chat/completions

# Which auth header the upstream expects: openai | anthropic | none.
# 'none' is for local models that take no key.
PROVIDER=openai

# Provider API key. It stays on this server; the browser never sees it.
PROVIDER_API_KEY=

# Comma-separated caller tokens. Your app sends one of them as
# "Authorization: Bearer <token>" via the editor's `headers` option.
# Several values let you rotate without downtime: add the new token, move
# callers across, then drop the old one.
# Replace the static list with a real session check in src/create-proxy.mjs
# before production (the readme shows two ready swaps). A static token
# reaches the browser, so any user can read it and spend your provider
# budget, and withdrawing it cuts off everyone at once. Placeholder values
# are refused when NODE_ENV=production.
AI_TOKENS=change-me

# Optional: comma-separated browser origins allowed to call the proxy
# cross-origin. Leave unset when the proxy shares an origin with your app,
# which is the safest setup.
#ALLOWED_ORIGINS=https://app.example.com

# Optional: total upstream cutoff per request, in milliseconds (default
# 120000). Raise it for slow local models whose replies take longer. Values
# above 300000 only bound streams that keep producing: Node's fetch cuts a
# fully silent stream at 300 s on its own (the readme shows the dispatcher
# escape hatch for forks that need more).
#REQUEST_TIMEOUT_MS=120000
